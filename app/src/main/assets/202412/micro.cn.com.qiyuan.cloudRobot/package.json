	"author": "lvkui <202300771@any3.com>",
	"scripts": {
		"dev": "vite",
		"serve": "vite --mode preproduction",
		"serve:pre": "vite --mode preproduction",
		"serve:pro": "vite --mode production",
		"build:test": "vite build --mode preproduction --emptyOutDir",
		"build:prod": "vite build --mode production --emptyOutDir",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:lint-staged": "lint-staged",
		"typecheck": "vue-tsc --noEmit --skipLibCheck",
		"format": "prettier --write \"src/**/*.ts\" \"src/**/*.vue\""
